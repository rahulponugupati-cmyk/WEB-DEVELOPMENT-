<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background-color: #f2f5fa;
      color: #222;
    }

    header {
      background-color: #2457a7;
      color: white;
      padding: 20px;
      text-align: center;
    }

    main {
      max-width: 900px;
      margin: 20px auto;
      padding: 0 16px;
    }

    section {
      background-color: white;
      margin: 16px 0;
      padding: 18px;
      border-radius: 8px;
    }

    h2 {
      color: #2457a7;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 10px;
      text-align: left;
    }

    th {
      background-color: #e5edfa;
    }

    .progress {
      background-color: #ddd;
      height: 18px;
      border-radius: 9px;
      overflow: hidden;
    }

    .bar {
      background-color: #2e9d62;
      height: 100%;
      width: 85%;
    }

    footer {
      background-color: #183d78;
      color: white;
      text-align: center;
      padding: 12px;
    }

    @media (max-width: 600px) {
      table {
        font-size: 14px;
      }

      th, td {
        padding: 7px;
      }
    }
  </style>
</head>

<body>
  <header>
    <h1>Student Academic Dashboard</h1>
    <p>Welcome, Your Name</p>
  </header>

  <main>
    <section>
      <h2>Student Details</h2>
      <p><strong>Name:</strong> Rahul KUmaar</p>
      <p><strong>Roll Number:</strong> 101</p>
      <p><strong>Department:</strong> Computer Science Engineering</p>
      <p><strong>Semester:</strong> First Semester</p>
    </section>

    <section>
      <h2>Attendance</h2>
      <p>Overall attendance: 85%</p>
      <div class="progress">
        <div class="bar"></div>
      </div>
    </section>

    <section>
      <h2>Subject Marks</h2>
      <table>
        <tr>
          <th>Subject</th>
          <th>Marks</th>
          <th>Maximum Marks</th>
        </tr>
        <tr>
          <td>Mathematics</td>
          <td>82</td>
          <td>100</td>
        </tr>
        <tr>
          <td>Physics</td>
          <td>76</td>
          <td>100</td>
        </tr>
        <tr>
          <td>Programming</td>
          <td>90</td>
          <td>100</td>
        </tr>
      </table>
    </section>

    <section>
      <h2>Examination Schedule</h2>
      <ul>
        <li>Mathematics — 10 November</li>
        <li>Physics — 13 November</li>
        <li>Programming — 16 November</li>
      </ul>
    </section>

    <section>
      <h2>Announcements</h2>
      <ul>
        <li>Submit your programming assignment by Friday.</li>
        <li>Library books must be returned before exams.</li>
      </ul>
    </section>
  </main>

  <footer>
    <p>© 2026 Student Dashboard</p>
  </footer>
</body>
</html>
